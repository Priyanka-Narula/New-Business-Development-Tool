# Copy this file to .env and provide values locally. Never commit .env.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# Shared Neon Postgres. Leave blank to use local aambridge.db (tests and offline).
# Copy the pooled connection string from the Aambridge Analytics project
# (hostname contains -pooler). Never commit the real URL.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_ECHO=false

# Local Ollama (install from https://ollama.com and run `ollama serve`)
OLLAMA_URL=http://localhost:11434/api/chat
EXTRACTION_MODEL=llama3.1

# Optional logging settings (relative to this folder)
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5

