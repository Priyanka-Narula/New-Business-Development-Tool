# Copy this file to .env and provide values locally. Never commit .env.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# Local SQLite file in this folder. Leave DATABASE_URL blank to use aambridge.db.
# Optional local PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:password@localhost/aambridge
DATABASE_ECHO=false

# Local Ollama (install from https://ollama.com and run `ollama serve`)
OLLAMA_URL=http://localhost:11434/api/chat
EXTRACTION_MODEL=llama3.1

# Optional logging settings (relative to this folder)
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5

